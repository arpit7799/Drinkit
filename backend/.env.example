# =============================================================================
# CivicAI Backend — Environment Configuration Template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- App metadata ---
APP_NAME=CivicAI
APP_ENV=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=Wweraw@779921
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
POSTGRES_USER=civicai
POSTGRES_PASSWORD=civicai_dev_password
POSTGRES_DB=civicai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://civicai:civicai_dev_password@localhost:5432/civicai_db
DATABASE_URL_SYNC=postgresql+psycopg2://civicai:civicai_dev_password@localhost:5432/civicai_db

# --- File storage ---
STORAGE_BACKEND=local        # local | s3 (cloud-ready, implemented later)
LOCAL_STORAGE_PATH=./storage/uploads
MAX_UPLOAD_SIZE_MB=10

# --- Email verification / password reset tokens ---
EMAIL_TOKEN_EXPIRE_MINUTES=30

# --- Google OAuth (Gmail send-as-user) — wired up in Phase 5 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/email/oauth/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.send

# --- Default city seed (Phase 1) ---
DEFAULT_CITY_NAME=Gurugram
DEFAULT_CITY_STATE=Haryana
DEFAULT_CITY_PINCODE=122001

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false