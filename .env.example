# Application
APP_NAME=Drinkit
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL. Use a local-only password for development; never commit real secrets.
DATABASE_URL=postgresql://drinkit:drinkit_dev_password@localhost:5432/drinkit
TEST_DATABASE_URL=postgresql://drinkit:drinkit_dev_password@localhost:5432/drinkit_test

# SQLAlchemy pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
SQL_ECHO=false

# Authentication. Replace the development value before production deployment.
JWT_SECRET_KEY=development-only-change-this-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS, comma-separated
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
